+	}
+	if msg := cmd(); reflect.TypeOf(msg) != reflect.TypeOf(bubbletea.SuspendMsg{}) {
+		t.Fatalf("Ctrl-Z message = %T, want SuspendMsg", msg)
+	}
+	if model.composerText() != "keep this draft" {
