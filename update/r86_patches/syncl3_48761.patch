+
+	SetOpenTranscriptHintProvider(func() string { return "" })
+	if got := TranscriptDisclosureHint(); got != "" {
+		t.Fatalf("unbound hint = %q, want empty", got)
+	}
+	if got := ToolOutputPreviewLines([]string{"one", "two", "three", "four"}, 60, 4); got[3] != "+1 line" {
